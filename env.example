# Grexx / IRMA (default). OAuth client_credentials, then Bearer on POST /realtime.
# Basic Auth is not accepted on acceptatie. Do not commit real values.
KPN_GREXX_USERNAME=
KPN_GREXX_PASSWORD=
# Interface root from the partner portal (API Gegevens), without /realtime.
KPN_GREXX_BASE_URL=https://service-accept.grexx.today/interfaces/kpn/kpn_partners_acceptatieomgeving/<interface-id>/
# Optional. Defaults to the acceptatie token endpoint. Production will differ.
# KPN_GREXX_TOKEN_URL=https://service-accept.grexx.today/oauth/access_token

# MCP_TRANSPORT=stdio
# AUTH_MODE=env
# MCP_HTTP_PORT=8080
# LOG_LEVEL=info

# Legacy developer.kpn.com tools (Disturbance Check, SIM Swap, MSM). Off unless set to 1.
# KPN_LEGACY_DEVELOPER_API=1
# KPN_CLIENT_ID=
# KPN_CLIENT_SECRET=
# KPN_MSM_CLIENT_ID=
# KPN_MSM_CLIENT_SECRET=
# KPN_BASE_URL=https://api-prd.kpn.com
