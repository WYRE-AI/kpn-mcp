# Grexx / IRMA (default). The SDK mints the token with HTTP Basic, then sends
# Bearer on POST /realtime. This server does not mint the token. Basic Auth on
# POST /realtime is rejected. Do not commit real values.
KPN_GREXX_USERNAME=
KPN_GREXX_PASSWORD=
# Interface root from the partner portal (API Gegevens), without /realtime.
KPN_GREXX_BASE_URL=https://service-accept.grexx.today/interfaces/kpn/kpn_partners_acceptatieomgeving/<interface-id>/
# Optional. Defaults to the acceptatie token endpoint. Production will differ.
# KPN_GREXX_TOKEN_URL=https://service-accept.grexx.today/oauth/access_token

# MCP_TRANSPORT=stdio
# AUTH_MODE=env
# MCP_HTTP_PORT=8080
# LOG_LEVEL=info

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder. Never commit a real value.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1
# even if MCP_HTTP_HOST is a wider address such as 0.0.0.0. A placeholder secret
# is still rejected. Do not use in production.
# MCP_ALLOW_INSECURE_DEV=1

# Bind address when a real CONDUIT_S2S_SECRET is set. Unset stays 0.0.0.0.
# The insecure-dev bypass ignores this and listens on 127.0.0.1 only.
# The container image sets 0.0.0.0.
# MCP_HTTP_HOST=127.0.0.1

# Legacy developer.kpn.com tools (Disturbance Check, SIM Swap, MSM). Off unless set to 1.
# KPN_LEGACY_DEVELOPER_API=1
# KPN_CLIENT_ID=
# KPN_CLIENT_SECRET=
# KPN_MSM_CLIENT_ID=
# KPN_MSM_CLIENT_SECRET=
# KPN_BASE_URL=https://api-prd.kpn.com
